<Window x:Class="NetGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetGuard • Google Material You Network Security Auditor"
        Height="800" Width="1120"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Progress Bar Row -->
            <RowDefinition Height="Auto"/>
            <!-- Navigation Tabs Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR (Google Material You Style) -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" Padding="24,18" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Material Icon Container -->
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BrushPrimaryContainer}" Margin="0,0,16,0">
                        <TextBlock Text="🛡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NetGuard" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0" FontFamily="Segoe UI"/>
                            <Border Background="{StaticResource BrushPrimaryContainer}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="Material You M3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushOnPrimaryContainer}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Аудит сетевого периметра, открытых портов и политик безопасности Windows" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnExport" Content="📄 Экспорт отчета" Style="{StaticResource MaterialSecondaryButton}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                    <Button x:Name="btnScan" Content="⚡ Начать аудит" Style="{StaticResource MaterialPillButton}" Click="BtnScan_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SCAN PROGRESS BANNER -->
        <Border x:Name="panelProgress" Grid.Row="1" Background="{StaticResource BrushSurfaceContainerHigh}" Padding="24,12" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtProgressStatus" Text="Выполняется глубокий аудит сетевого стека..." Foreground="{StaticResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,8"/>
                <ProgressBar x:Name="pbScan" Grid.Row="1" Height="6" Value="0" Maximum="100" Foreground="{StaticResource BrushPrimary}" Background="{StaticResource BrushSurface}"/>
            </Grid>
        </Border>

        <!-- NAVIGATION PILL TABS -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" Padding="20,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="tabOverview" Content="📊 Обзор и Скоринг" Style="{StaticResource MaterialNavTab}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabSecurity" Content="🛡️ Безопасность и Политики" Style="{StaticResource MaterialNavTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabPorts" Content="🔌 Открытые порты" Style="{StaticResource MaterialNavTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabAdapters" Content="🌐 Адаптеры и DNS" Style="{StaticResource MaterialNavTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabFixes" Content="💡 Рекомендации и Fixes" Style="{StaticResource MaterialNavTab}" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="3" Margin="24,20">
            <!-- TAB 1: OVERVIEW -->
            <ScrollViewer x:Name="viewOverview" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- HERO SCORE CARD -->
                    <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="22" Padding="28" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Score Display -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="ОЦЕНКА БЕЗОПАСНОСТИ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="txtScore" Text="—" FontSize="56" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" FontFamily="Segoe UI"/>
                                    <TextBlock Text=" / 100" FontSize="20" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,12" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <Border x:Name="borderRatingBadge" CornerRadius="12" Background="{StaticResource BrushPrimaryContainer}" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="txtRatingBadge" Text="ГОТОВ К ПРОВЕРКЕ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushOnPrimaryContainer}"/>
                                </Border>
                            </StackPanel>

                            <!-- Telemetry Metrics Grid -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="txtScoreSummary" Text="Нажмите «Начать аудит» для запуска комплексного анализа сети и параметров защиты Windows." FontSize="14" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                    <!-- Metric 1: Gateway -->
                                    <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="14" Padding="14,10" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Основной шлюз сети" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock x:Name="txtGatewayInfo" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="txtGatewayPing" Text="Пинг: —" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 2: DNS -->
                                    <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="14" Padding="14,10" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="DNS Скорость &amp; Резолвинг" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock x:Name="txtDnsInfo" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="txtDnsLatency" Text="Отклик: —" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 3: Public IP -->
                                    <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="14" Padding="14,10" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Внешний IP адрес" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock x:Name="txtPublicIP" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                            <TextBlock Text="HTTPS интернет-канал" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 4: Adapter -->
                                    <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="14" Padding="14,10" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Активный интерфейс" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock x:Name="txtActiveAdapter" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Локальный адаптер" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- QUICK COUNTERS ROW -->
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="16" Padding="18" Margin="0,0,10,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Всего тестов" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="txtTotalChecks" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                <TextBlock Text="Сетевой стек и реестр Windows" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="16" Padding="18" Margin="5,0,5,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Безопасно (Норма)" FontSize="12" Foreground="#76D499"/>
                                <TextBlock x:Name="txtPassedChecks" Text="0" FontSize="28" FontWeight="Bold" Foreground="#76D499" Margin="0,4,0,0"/>
                                <TextBlock Text="Уязвимости не обнаружены" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="16" Padding="18" Margin="10,0,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Замечания и Угрозы" FontSize="12" Foreground="#FF8D80"/>
                                <TextBlock x:Name="txtIssueChecks" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF8D80" Margin="0,4,0,0"/>
                                <TextBlock Text="Требуется проверка конфигурации" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- QUICK SUMMARY LIST -->
                    <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="18" Padding="22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Быстрый аудит ключевых компонентов" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>
                            <ItemsControl x:Name="icOverviewSummary">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{Binding BadgeBackground}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding BadgeForeground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding StatusValue}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: SECURITY & POLICIES -->
            <ScrollViewer x:Name="viewSecurity" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Результаты проверки параметров безопасности Windows" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="icSecurityChecks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="18" Padding="20" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="8" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="10" Padding="12,5">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Value -->
                                        <TextBlock Grid.Row="1" Text="{Binding StatusValue}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                        <!-- Recommendation & Fix -->
                                        <Border Grid.Row="3" Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="12" Padding="14,10" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Recommendation}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasFixCommand}">
                                                    <TextBox Text="{Binding FixCommand, Mode=OneWay}" IsReadOnly="True" Background="#16181D" Foreground="#A8C7FA" BorderBrush="{StaticResource BrushBorder}" Padding="8,4" FontSize="11" FontFamily="Consolas" Width="680"/>
                                                    <Button Content="Копировать команду" Tag="{Binding FixCommand}" Click="BtnCopyFix_Click" Style="{StaticResource MaterialPillButton}" FontSize="11" Padding="12,5" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: OPEN PORTS -->
            <ScrollViewer x:Name="viewPorts" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="16" Padding="18" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Прослушиваемые локальные сетевые порты (TCP)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Показывает активные службы на вашем компьютере. Особое внимание уделите портам, открытым на 0.0.0.0 (они доступны для устройств в вашей локальной сети или Wi-Fi)." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="icPorts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="14" Padding="16,14" Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Port Badge -->
                                        <Border Grid.Column="0" Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Port, StringFormat='Port {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                                        </Border>

                                        <!-- Service Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding ServiceName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding LocalAddress}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>

                                        <!-- Exposure Info -->
                                        <Border Grid.Column="2" Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExposureText}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                                        </Border>

                                        <!-- Details -->
                                        <TextBlock Grid.Column="3" Text="{Binding Details}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0"/>

                                        <!-- Risk Badge -->
                                        <Border Grid.Column="4" Background="{Binding RiskBackground}" CornerRadius="10" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskLevel, StringFormat='Риск: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{Binding RiskForeground}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 4: ADAPTERS & DNS -->
            <ScrollViewer x:Name="viewAdapters" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Обнаруженные сетевые интерфейсы и параметры IP" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="icAdapters">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="18" Padding="22" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Adapter Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,0"/>
                                                <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="8" Padding="8,3">
                                                    <TextBlock Text="{Binding InterfaceType}" FontSize="11" Foreground="{StaticResource BrushPrimary}"/>
                                                </Border>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource BrushPrimaryContainer}" CornerRadius="8" Padding="10,4">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushOnPrimaryContainer}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,14"/>

                                        <!-- Adapter Properties Grid -->
                                        <UniformGrid Grid.Row="2" Columns="3" Rows="2">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="IPv4 Адрес" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding IPv4Address}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Маска подсети" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding SubnetMask}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Основной шлюз" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding Gateway}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="DNS Серверы" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding DnsServers}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="MAC Адрес" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding MacAddress}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Скорость подключения" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding Speed}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 5: REMEDIATION & FIXES -->
            <ScrollViewer x:Name="viewFixes" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="18" Padding="22" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Центр рекомендаций и быстрого устранения угроз" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Ниже собраны готовые команды PowerShell для безопасного исправления выявленных проблем. Запустите PowerShell от имени администратора и выполните нужную команду." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="icFixRecommendations">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceContainer}" CornerRadius="16" Padding="18" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{Binding BadgeBackground}" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Recommendation}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="10" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding FixCommand, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#A8C7FA" BorderThickness="0" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Скопировать" Tag="{Binding FixCommand}" Click="BtnCopyFix_Click" Style="{StaticResource MaterialPillButton}" FontSize="11" Padding="12,4" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="4" Background="{StaticResource BrushSurface}" Padding="24,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtFooterStatus" Text="Готово к работе. Нажмите «Начать аудит»." FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                <TextBlock Grid.Column="1" Text="NetGuard v1.0 • Standalone Windows Security Tool" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
